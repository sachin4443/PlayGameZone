# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# ---- Database (PostgreSQL) ----
# Special characters in the password must be URL-encoded (e.g. "@" -> "%40").
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@localhost:5431/AlwaysGame?schema=public"
# Separate database used ONLY by the automated tests (its tables are truncated between tests).
TEST_DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@localhost:5431/AlwaysGame_test?schema=public"

# ---- Auth ----
# Long random string, e.g. `openssl rand -hex 48`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# "dev"  = temporary login: the one-time code is returned to the client instead of being sent by SMS.
# "sms"  = production: the code is delivered through the SMS provider (see src/modules/auth/otp.ts).
AUTH_PROVIDER=dev
# The dev provider is refused when NODE_ENV=production unless this is explicitly "true".
ALLOW_DEV_AUTH_IN_PRODUCTION=false

# ---- Seed (initial super admin, used by `npm run seed`) ----
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=change-this-password
