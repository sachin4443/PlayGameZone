# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# ---- Database (PostgreSQL) ----
# Special characters in the password must be URL-encoded (e.g. "@" -> "%40").
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@localhost:5431/AlwaysGame?schema=public"
# Separate database used ONLY by the automated tests (its tables are truncated between tests).
TEST_DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@localhost:5431/AlwaysGame_test?schema=public"

# ---- Auth ----
# Long random string, e.g. `openssl rand -hex 48`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Players sign in with mobile number + PIN. AUTH_PROVIDER is reserved for the SMS step
# that will be added in front of registration (see src/modules/auth/otp.ts).
AUTH_PROVIDER=dev

# ---- Seed (initial super admin, used by `npm run seed`) ----
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=change-this-password

# ---- Root owner (highest authority; created once by `npm run seed`) ----
# Set both, run the seed, sign in and change the password when asked,
# then delete ROOT_OWNER_PASSWORD from this file.
ROOT_OWNER_USERNAME=
ROOT_OWNER_PASSWORD=
